generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(uuid())
  title       String
  image       String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  brand       String[]
  products    Product[]
}

model Product {
  id          String   @id @default(uuid())
  title       String
  description String?
  image       String?
  initPrice   Float
  finalPrice  Float
  stock       Int      @default(0)
  brand       String?
  categoryId  String
  info        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}
